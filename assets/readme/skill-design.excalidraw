      "link": null,
      "locked": false,
      "text": "- Someone new can read it in two minutes\n- One of four board formats, never a fifth\n- Marks a part built only if it's in the code\n- Checks the real render before handing over\n- Never loses the drawing you already had",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Someone new can read it in two minutes\n- One of four board formats, never a fifth\n- Marks a part built only if it's in the code\n- Checks the real render before handing over\n- Never loses the drawing you already had",
      "autoResize": true,
      "lineHeight": 1.25
